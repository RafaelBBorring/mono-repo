      },
      "narrativa": {
        "conceito": "",
        "vinculo": "",
        "cicatriz": ""
      },
      "anotacoes": "Garras de Adamantium:\n+3d6 de Bonus em Ataque (Valor de Sucesso 6) - Se acertar -2 Absorção.\n\nUltimate:\n+4d6 de Esquiva\n8 no Valor de Sucesso\n\n",
      "resources": {
        "vida": 43,
        "energia": 27,
        "pe": 23
      },
      "conditions": [],
      "abilities": {
        "passiva": {
          "id": "ab_rzp8vcx",
          "kind": "passiva",
          "name": "Regeneração Adamântica",
          "descricao": "A cada rodada, Kalistel regenera 1d6 de Vida (mínimo 1). Quando recebe dano, pode rolar um d6 adicional; 5‑6 aumentam a cura desse turno em +1d6. A regeneração não requer Energia, mas consome 1 PE ao ser acionada duas vezes no mesmo turno.",
          "energia": 0,
          "tags": [
            {
              "label": "cura",
              "color": "#4CAF50"
            },
            {
              "label": "passiva",
              "color": "#9E9E9E"
            }
          ]
        },
        "ativa1": {
          "id": "ab_ul00inv",
          "kind": "ativa",
          "name": "Garras de Adamantium",
          "descricao": "Ataque corpo‑a‑corpo usando as três garras de cada antebraço. Rola FOR (6) como pool de ataque. Cada sucesso vale 4 de dano (valor de sucesso = 4). \n\nAcrescenta +2d6 ao pool (bônus de arma média). \n\nSe o alvo falhar na Esquiva, o dano ignora 2 pontos de Absorção (aço cortante).",
          "energia": 4,
          "tags": [
            {
              "label": "+3d6 de Bonus em Ataque",
              "color": "#ff5e5e"
            },
            {
              "label": "Valor de Sucesso 6",
              "color": "#f39c12"
            },
            {
              "label": "Se acertar -2 Absorção",
              "color": "#f6d98c"
            }
          ]
        },
        "ativa2": {
          "id": "ab_o58nx4g",
          "kind": "ativa",
          "name": "Vigor de Adamantium",
          "descricao": "Gasta 1 PE para conceder +2d6 de Esquiva (ele próprio ou aliado) até o final da rodada. Se usado em si mesmo, também gera um escudo que concede +1 sucesso extra na Esquiva até o próximo turno.",
          "energia": 3,
          "tags": [
            {
              "label": "defesa",
              "color": "#03A9F4"
            },
            {
              "label": "suporte",
              "color": "#8BC34A"
            }
          ]
        },
        "ativa3": {
          "id": "ab_vk51qyq",
          "kind": "ativa",
          "name": "Toque Curativo",
          "descricao": "Gasta 2 PE e rola INT (1) + PER (1) como ação combinada. Cada sucesso cura 2d6 de Vida. Pode ser usado em si mesmo ou aliado que esteja em estado crítico (Vida ≤ 0).",
          "energia": 3,
          "tags": [
            {
              "label": "cura",
              "color": "#4CAF50"
            },
            {
              "label": "toque",
              "color": "#FF9800"
            }
          ]
        },
        "ultimate": {
          "id": "ab_k9ir1ev",
          "kind": "ultimate",
          "name": "Metamorfose Adamântica",
          "descricao": "Kalistel se envolve em uma armadura total de adamantium por 3 rodadas. Enquanto ativa: +4d6 de Esquiva; todas as suas Garras de Adamantium recebem +2 de valor por sucesso (passam a 4); e a Regeneração Adamântica dobra seu ganho (2d6 + bônus de d6). Ao final da duração, ele inflige um golpe final de área: 3d6 de dano cortante a todos os inimigos adjacentes (valor de sucesso = 3). Custa 12 de Energia e 2 PE na ativação.",
          "energia": 12,
          "tags": [
            {
              "label": "+4d6 de Esquiva",
              "color": "#f2661b"
            },
            {
              "label": "Garrar de Adamantium: 8 ",
              "color": "#ff5e5e"
            }
          ]
        }
      },
      "createdAt": "2026-06-18T09:35:06.328Z",
      "updatedAt": "2026-06-26T13:18:57.672Z"
