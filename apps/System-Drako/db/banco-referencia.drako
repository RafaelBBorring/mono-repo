    {
      "id": "chr_mqiqpyab4557exzm",
      "name": "Kael Ardent",
      "icon": null,
      "folderId": null,
      "isNPC": true,
      "level": "veterano",
      "raca": "Mago de Batalha",
      "arquetipo": "",
      "attributes": {
