# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase client values. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-only value. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe server-only values.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe recurring Price IDs created in the Dashboard.
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx

# Stripe client-side values. Used on static builds (GitHub Pages) for client-only checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_xxx

# Enable the app-level billing screen after Stripe + webhook are working.
NEXT_PUBLIC_BILLING_REQUIRED=false

# Set false for static GitHub Pages builds. Keep true on Docker/server deploys.
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=true

# Optional: public URL of a separate backend when the frontend is on GitHub Pages.
NEXT_PUBLIC_API_BASE_URL=
