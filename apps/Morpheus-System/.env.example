# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase client values. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-only value. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe server-only values.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe recurring Price IDs created in the Dashboard. Server runtime only.
STRIPE_PRICE_ESSENTIAL_MONTHLY=price_xxx
STRIPE_PRICE_ESSENTIAL_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ELITE_YEARLY=price_xxx

# Enable the app-level billing screen after Stripe + webhook are working.
NEXT_PUBLIC_BILLING_REQUIRED=false

# Set false for static GitHub Pages builds. Keep true on Docker/server deploys.
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=true

# Optional: public URL of a separate backend when the frontend is on GitHub Pages.
NEXT_PUBLIC_API_BASE_URL=

# Optional public Stripe Payment Links for GitHub Pages/static tests.
# These are not secret keys. Keep STRIPE_SECRET_KEY only on a server runtime.
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_PRO_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_ELITE_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_ELITE_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_TRIAL=
