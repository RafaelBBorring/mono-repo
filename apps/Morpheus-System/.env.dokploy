# Dokploy - Variaveis de ambiente para deploy
# Copie os valores reais para o painel do Dokploy (Environment tab)

# Dominio do servico (usado pelo Traefik para roteamento)
MORPHEUS_DOMAIN=morpheus.seudominio.com

# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://morpheus.seudominio.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ESSENTIAL_MONTHLY=price_xxx
STRIPE_PRICE_ESSENTIAL_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ELITE_YEARLY=price_xxx

# Feature flags
NEXT_PUBLIC_BILLING_REQUIRED=true
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SERVER_API_AVAILABLE=true
NEXT_PUBLIC_API_BASE_URL=

# Stripe Payment Links (publicos, para static builds)
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_ESSENTIAL_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_PRO_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_ELITE_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_ELITE_ANUAL=
NEXT_PUBLIC_STRIPE_LINK_TRIAL=
