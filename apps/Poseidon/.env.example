# Copy this file to .env and edit as needed
# Backend reads this automatically via pydantic-settings

# Storage paths
STORAGE_PATH=./data
TEMP_PATH=./data/temp
VIDEOS_PATH=./data/videos
THUMBNAILS_PATH=./data/thumbnails
EMBEDDINGS_PATH=./data/embeddings
FEATURES_PATH=./data/features
MODELS_PATH=./models

# File limits
MAX_FILE_SIZE_MB=1024
CHUNK_SIZE_MB=10
CLEANUP_HOURS=24

# AI models
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
YOLO_MODEL_PATH=./models/yolov8n.pt
YOLO_CONFIDENCE=0.4

# Frame extraction
FRAME_SAMPLE_RATE=5
MAX_FRAMES_FOR_ANALYSIS=120

# Classification thresholds
AUTO_CLASSIFY_THRESHOLD=0.85
HUMAN_REVIEW_THRESHOLD=0.40

# Agent weights (must sum to 1.0)
FACE_WEIGHT=0.35
POSE_WEIGHT=0.20
BOARD_WEIGHT=0.25
STYLE_WEIGHT=0.20

# Database
DATABASE_URL=sqlite+aiosqlite:///./surf_classifier.db

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
