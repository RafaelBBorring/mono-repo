# Copy this file to .env and edit as needed

STORAGE_PATH=./data
TEMP_PATH=./data/temp
VIDEOS_PATH=./data/videos
THUMBNAILS_PATH=./data/thumbnails
EMBEDDINGS_PATH=./data/embeddings
FEATURES_PATH=./data/features
MODELS_PATH=./models

MAX_FILE_SIZE_MB=1024
CHUNK_SIZE_MB=10
CLEANUP_HOURS=24

FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
YOLO_MODEL_PATH=./models/yolov8n.pt
YOLO_CONFIDENCE=0.4

FRAME_SAMPLE_RATE=5
MAX_FRAMES_FOR_ANALYSIS=120

AUTO_CLASSIFY_THRESHOLD=0.55
HUMAN_REVIEW_THRESHOLD=0.20

FACE_WEIGHT=0.10
POSE_WEIGHT=0.20
BOARD_WEIGHT=0.50
CLOTHING_WEIGHT=0.20

BOARD_SIM_THRESHOLD=0.55
CLOTHING_SIM_THRESHOLD=0.60
POSE_SIM_THRESHOLD=0.65
FACE_SIM_THRESHOLD=0.55

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

PHASE1_THRESHOLD=0.40
PHASE2_THRESHOLD=0.60

DATABASE_URL=sqlite+aiosqlite:///./surf_classifier.db

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
