VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
VITE_MIRO_WEB_SDK_URL=http://localhost:5173/#/app/miro-capture
VITE_ENABLE_DEMO=true

# Backend Supabase Edge Functions (somente servidor)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
APP_URL=http://localhost:5173
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_REDIRECT_URI=
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TEXT_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free,openrouter/free
INTEGRATION_ENCRYPTION_KEY=

# Stack Cloudflare (próxima fase — Migração de Supabase para CF)
# D1 (banco SQL): criar via `wrangler d1 create maestro-db`
# R2 (storage de imagens/Miro cache): criar via `wrangler r2 bucket create maestro-media`
# Vectorize (índice para o Yggdrasil/Mapa Mental): criar via `wrangler vectorize create index yggrasil-entities`
# Workers AI: habilitar no dashboard do Worker (GLM-4 disponível nativamente)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
CF_R2_BUCKET=maestro-media
CF_VECTORIZE_INDEX=yggrasil-entities
CF_WORKERS_AI=true
